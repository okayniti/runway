# Copy to .env for local overrides (gitignored), or set these directly in
# your deployment platform's dashboard. Every one of these is optional --
# the app runs with sensible local defaults if none are set at all. See
# DEPLOYMENT.md for which of these actually matter in production and why.

# Slack Incoming Webhook URL. No alert fires without this set -- see
# README.md's Setup section for how to create one.
RUNWAY_WEBHOOK_URL=

# JSON map of API key -> tenant_id. Defaults to {"demo-key": "demo-tenant"}
# if unset -- fine for local dev, replace before deploying anywhere real.
RUNWAY_API_KEYS={"demo-key": "demo-tenant"}

# Comma-separated origins allowed to call this API directly from a browser.
# Leave empty locally -- the frontend talks to this API through its own
# same-origin proxy, which needs no CORS entry at all.
RUNWAY_CORS_ORIGINS=

# Where the SQLite history file lives. Defaults to agent/store.db.
# In production, set this to a path on the platform's persistent
# volume/disk, or the store resets on every redeploy.
RUNWAY_DB_PATH=

# Background scheduler (opt-in; disabled unless explicitly set to true).
RUNWAY_SCHEDULER_ENABLED=false
RUNWAY_SCHEDULE_INTERVAL_SECONDS=3600
RUNWAY_SCHEDULE_DATA_CSV=data/synthetic_transactions.csv
RUNWAY_SCHEDULE_SHORTFALL_THRESHOLD=0
RUNWAY_SCHEDULE_TENANT_ID=default

# Set by the deployment platform itself (Railway/Render) -- you shouldn't
# need to set this by hand. Only read by the `python api/app.py` fallback
# entry point; the normal `uvicorn ... --port $PORT` start command reads
# it directly from the shell instead.
PORT=8000
