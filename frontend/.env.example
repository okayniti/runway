# Copy to .env.local for local overrides (gitignored), or set this in
# Vercel's project settings. Optional locally -- defaults to
# http://127.0.0.1:8000, which is where the backend's Setup instructions
# (../README.md) tell you to run it.
#
# This is a plain (non-NEXT_PUBLIC_) variable on purpose: it's read only
# by next.config.ts's server-side rewrite, never by browser code, so the
# backend's real URL never ships in the client bundle -- see the comment
# at the top of next.config.ts for the full reasoning. Set it to your
# deployed Railway/Render backend's URL, no trailing slash.
BACKEND_URL=
