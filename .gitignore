# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Model checkpoints and artifacts. The checkpoint actually used for
# deployment (model/checkpoints/bilstm_cashflow.pt) is committed by
# exception below -- it's ~23KB (a 4,350-parameter model), and a fresh
# deploy shouldn't need a multi-minute model/train.py run just to serve
# its first request. Anything else under checkpoints/ (alternate runs, a
# larger architecture someone trains locally) stays ignored.
*.pth
*.ckpt
*.onnx
*.log
model/checkpoints/*
!model/checkpoints/bilstm_cashflow.pt

# Generated synthetic/raw data (reproducible via data/generate_synthetic_transactions.py)
data/*.csv

# Generated exception reports (reproducible via reports/generate_report.py)
reports/*.md

# Local operational state -- accumulated forecast-run history, not reproducible
# build output, but still shouldn't be committed (it's this environment's data,
# not source).
agent/*.db

# Env / secrets
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
